# ============================================================
# BR Academy — Configuração do Time de Agentes Claude
# ============================================================
# Copie este arquivo para .env e preencha com suas credenciais:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env — ele contém segredos!
# ============================================================

# Chave da API Anthropic (obrigatória)
# Crie em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modelo padrão (opcional — o script usa claude-sonnet-4-6 por padrão)
# Opções: claude-opus-4-6 (mais inteligente), claude-sonnet-4-6 (equilibrado), claude-haiku-4-5 (mais barato)
CLAUDE_MODEL=claude-sonnet-4-6
