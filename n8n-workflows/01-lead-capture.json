      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": "={{ $json.source }}",
              "rightValue": "instagram",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.source }}",
              "rightValue": "facebook",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.source }}",
              "rightValue": "whatsapp",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.source }}",
              "rightValue": "website",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{ $json.source }}",
              "rightValue": "referral",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "filter-source",
      "name": "Validate Source",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "lead_id",
              "name": "lead_id",
              "value": "={{ 'BR-' + $now.format('yyyyMMdd') + '-' + Math.random().toString(36).substring(2, 8).toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "name",
              "name": "name",
              "value": "={{ $json.name || $json.nome || '' }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ $json.email || '' }}",
              "type": "string"
            },
            {
              "id": "phone",
              "name": "phone",
              "value": "={{ $json.phone || $json.telefone || $json.whatsapp || '' }}",
              "type": "string"
            },
            {
              "id": "source",
              "name": "source",
              "value": "={{ $json.source || 'website' }}",
              "type": "string"
            },
            {
              "id": "nationality",
              "name": "nationality",
              "value": "={{ $json.nationality || $json.nacionalidade || '' }}",
              "type": "string"
            },
            {
              "id": "visa_type",
              "name": "visa_type",
              "value": "={{ $json.visa_type || $json.tipo_visto || '' }}",
              "type": "string"
            },
            {
              "id": "english_level",
              "name": "english_level",
              "value": "={{ $json.english_level || $json.nivel_ingles || '' }}",
              "type": "string"
            },
            {
              "id": "preferred_date",
              "name": "preferred_date",
              "value": "={{ $json.preferred_date || $json.data_preferida || '' }}",
              "type": "string"
            },
            {
              "id": "stage",
              "name": "stage",
              "value": "new_lead",
              "type": "string"
            },
            {
              "id": "score",
              "name": "score",
              "value": "0",
              "type": "number"
            },
            {
              "id": "created_at",
              "name": "created_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "updated_at",
              "name": "updated_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "notes",
              "name": "notes",
              "value": "={{ $json.message || $json.mensagem || '' }}",
              "type": "string"
            },
            {
              "id": "utm_source",
              "name": "utm_source",
              "value": "={{ $json.utm_source || '' }}",
              "type": "string"
            },
            {
              "id": "utm_campaign",
              "name": "utm_campaign",
              "value": "={{ $json.utm_campaign || '' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "set-lead-data",
      "name": "Format Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [690, 300]
