    {
      "parameters": {
        "jsCode": "const agentOutput = $input.first().json;\nconst context = $('Build Context').first().json;\n\nlet fullResponse = agentOutput.output || agentOutput.text || '';\nlet notifyAdmin = false;\nlet escalationReason = '';\n\n// Check for human escalation marker\nif (fullResponse.includes('[ESCALACAO_HUMANA]')) {\n  notifyAdmin = true;\n  escalationReason = 'Lead solicitou atendimento humano ou assunto complexo';\n  fullResponse = fullResponse.replace('[ESCALACAO_HUMANA]', '').trim();\n}\n\n// Extract metadata line\nconst metaMatch = fullResponse.match(/\\[STAGE:(\\w+)\\|FOLLOWUP:(\\d+)\\|SCORE_DELTA:([+-]?\\d+)\\]/);\nlet stage = context.stage;\nlet followUpHours = 24;\nlet scoreDelta = 0;\n\nif (metaMatch) {\n  stage = metaMatch[1];\n  followUpHours = parseInt(metaMatch[2]);\n  scoreDelta = parseInt(metaMatch[3]);\n  fullResponse = fullResponse.replace(metaMatch[0], '').trim();\n}\n\nconst newScore = Math.min(100, Math.max(0, (parseInt(context.score) || 0) + scoreDelta));\n\nreturn [{\n  json: {\n    lead_id: context.lead_id,\n    phone: context.phone,\n    name: context.name,\n    response_message: fullResponse,\n    suggested_stage: stage,\n    follow_up_hours: followUpHours,\n    score_delta: scoreDelta,\n    new_score: newScore,\n    notify_admin: notifyAdmin,\n    escalation_reason: escalationReason,\n    original_message: context.message\n  }\n}];"
      },
      "id": "code-process-response",
      "name": "Process Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.response_message || '';\n\n// Normalize line breaks\nconst normalized = String(text)\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\r/g, '\\n')\n  .trim();\n\n// Split by paragraphs (double line breaks)\nlet parts = normalized\n  .split(/\\n\\s*\\n+/)\n  .map(p => p.trim())\n  .filter(Boolean);\n\n// Fallback: split by single line breaks if only 1 part\nif (parts.length <= 1) {\n  parts = normalized\n    .split('\\n')\n    .map(p => p.trim())\n    .filter(Boolean);\n}\n\n// If still 1 part and long (>300 chars), split by sentences\nif (parts.length <= 1 && normalized.length > 300) {\n  parts = normalized\n    .split(/(?<=[.!?])\\s+/)\n    .reduce((acc, sentence) => {\n      const last = acc[acc.length - 1];\n      if (last && (last + ' ' + sentence).length < 200) {\n        acc[acc.length - 1] = last + ' ' + sentence;\n      } else {\n        acc.push(sentence);\n      }\n      return acc;\n    }, []);\n}\n\nconst context = $('Process Response').first().json;\n\nreturn parts.map(p => ({\n  json: {\n    Mensagem: p,\n    phone: context.phone,\n    lead_id: context.lead_id,\n    name: context.name,\n    suggested_stage: context.suggested_stage,\n    new_score: context.new_score,\n    follow_up_hours: context.follow_up_hours,\n    notify_admin: context.notify_admin,\n    escalation_reason: context.escalation_reason,\n    original_message: context.original_message\n  }\n}));"
      },
