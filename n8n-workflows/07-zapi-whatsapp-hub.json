    {
      "parameters": {
        "httpMethod": "POST",
        "path": "br-academy-zapi-send",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-zapi-send",
      "name": "Send Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -800,
        1200
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst phone = input.phone;\nconst instanceId = $env.ZAPI_INSTANCE_ID;\nconst token = $env.ZAPI_TOKEN;\nconst clientToken = $env.ZAPI_CLIENT_TOKEN;\nconst baseUrl = `https://api.z-api.io/instances/${instanceId}/token/${token}`;\n\nlet endpoint = '';\nlet body = {};\n\nswitch (input.type || 'text') {\n  case 'text':\n    endpoint = '/send-text';\n    body = { phone, message: input.message, delayTyping: 8 };\n    break;\n  case 'image':\n    endpoint = '/send-image';\n    body = { phone, image: input.media_url, caption: input.message || '', delayTyping: 5 };\n    break;\n  case 'document':\n    endpoint = '/send-document/pdf';\n    body = { phone, document: input.media_url, fileName: input.file_name || 'documento.pdf', caption: input.message || '', delayTyping: 3 };\n    break;\n  case 'video':\n    endpoint = '/send-video';\n    body = { phone, video: input.media_url, caption: input.message || '', delayTyping: 5 };\n    break;\n  case 'audio':\n    endpoint = '/send-audio';\n    body = { phone, audio: input.audio_url, delayTyping: 8 };\n    break;\n  case 'buttons':\n    endpoint = '/send-button-list';\n    body = { phone, message: input.message, buttonList: { buttons: (input.buttons || []).map(b => ({ id: b.id, label: b.label })) }, delayTyping: 5 };\n    break;\n  case 'list':\n    endpoint = '/send-option-list';\n    body = { phone, optionList: { title: input.list_title || 'Opcoes', message: input.message, footer: input.footer || 'BR Academy', buttonLabel: input.button_label || 'Ver opcoes', options: input.options || [] }, delayTyping: 5 };\n    break;\n  default:\n    endpoint = '/send-text';\n    body = { phone, message: input.message, delayTyping: 8 };\n}\n\nreturn [{ json: { url: baseUrl + endpoint, body, phone, type: input.type || 'text', clientToken } }];"
      },
      "id": "zapi-send-router",
      "name": "Z-API Send Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        1200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "client-token",
              "value": "={{ $json.clientToken || $env.ZAPI_CLIENT_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "zapi-send-execute",
      "name": "Z-API Send Execute",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        1200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, zapiResponse: $json }) }}",
        "options": {}
      },
      "id": "zapi-send-response",
