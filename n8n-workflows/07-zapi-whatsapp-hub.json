    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body || raw;\n\nlet phone = body.phone || body.chatId || body.from || '';\nphone = phone.replace('@c.us', '').replace('@s.whatsapp.net', '');\n\nlet messageType = 'text';\nlet messageContent = '';\nlet mediaUrl = '';\nlet fileName = '';\n\nif (body.audio) {\n  messageType = 'audio';\n  mediaUrl = body.audio.audioUrl;\n  messageContent = '[AUDIO_PENDENTE_TRANSCRICAO]';\n} else if (body.image) {\n  messageType = 'image';\n  mediaUrl = body.image.imageUrl;\n  messageContent = body.image.caption || '[Imagem sem legenda]';\n} else if (body.video) {\n  messageType = 'video';\n  mediaUrl = body.video.videoUrl;\n  messageContent = body.video.caption || '[Video]';\n} else if (body.document) {\n  messageType = 'document';\n  mediaUrl = body.document.documentUrl;\n  fileName = body.document.fileName || 'documento';\n  messageContent = `[Documento: ${fileName}]`;\n} else if (body.sticker) {\n  messageType = 'sticker';\n  messageContent = '[Sticker]';\n} else if (body.listResponseMessage) {\n  messageType = 'list_response';\n  messageContent = body.listResponseMessage.title || body.listResponseMessage.singleSelectReply?.selectedRowId || '';\n} else if (body.buttonsResponseMessage) {\n  messageType = 'button_response';\n  messageContent = body.buttonsResponseMessage.selectedButtonId || body.buttonsResponseMessage.selectedDisplayText || '';\n} else if (body.text) {\n  messageType = 'text';\n  messageContent = body.text.message || body.text || '';\n} else {\n  messageType = 'unknown';\n  messageContent = JSON.stringify(body).substring(0, 200);\n}\n\n// Ignore status messages and own messages\nconst isFromMe = body.fromMe === true;\nconst isStatus = phone === 'status' || phone === '';\n\nreturn [{\n  json: {\n    phone,\n    message_type: messageType,\n    message_content: messageContent,\n    media_url: mediaUrl,\n    file_name: fileName,\n    is_from_me: isFromMe,\n    is_status: isStatus,\n    raw_timestamp: body.timestamp || Date.now()\n  }\n}];"
      },
      "id": "parse-zapi-msg",
      "name": "Parse Z-API Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
