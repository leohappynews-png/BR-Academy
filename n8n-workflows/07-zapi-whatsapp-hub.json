    {
      "parameters": {
        "jsCode": "function normalizeIrishPhone(rawPhone) {\n  if (!rawPhone) return null;\n  let phone = rawPhone.toString().trim().replace(/[^\\d+]/g, '');\n  if (phone.startsWith('+353')) return phone;\n  if (phone.startsWith('353')) return `+${phone}`;\n  if (phone.startsWith('08')) return `+353${phone.substring(1)}`;\n  if (phone.length === 9 && phone.startsWith('8')) return `+353${phone}`;\n  // Also handle Brazilian numbers\n  if (phone.startsWith('+55')) return phone;\n  if (phone.startsWith('55') && phone.length >= 12) return `+${phone}`;\n  return phone.startsWith('+') ? phone : `+${phone}`;\n}\n\nconst input = $input.first().json;\nconst normalizedPhone = normalizeIrishPhone(input.phone);\n\nreturn [{\n  json: {\n    ...input,\n    original_phone: input.phone,\n    normalized_phone: normalizedPhone\n  }\n}];"
      },
