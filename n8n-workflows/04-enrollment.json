      "parameters": {
        "method": "POST",
        "url": "={{$env.N8N_WEBHOOK_BASE_URL}}/webhook/br-academy-zapi-send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"message\": \"Oi {{ $json.name }}! Sua matricula na BR Academy foi CONFIRMADA! \\n\\nID: {{ $json.enrollment_id }}\\nCurso: {{ $json.course_type === 'weekend' ? 'Fim de Semana' : 'Noturno' }}\\nData: {{ $json.course_date }}\\n\\nVoce vai receber os documentos e instrucoes por email.\\n\\nBem-vindo(a) a familia BR Academy! Estamos ansiosos para te receber!\",\n  \"type\": \"text\",\n  \"delayTyping\": 8\n}",
        "options": {}
      },
