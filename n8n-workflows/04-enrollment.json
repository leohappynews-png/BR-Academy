      "id": "stripe-webhook",
      "name": "Stripe Trigger",
      "type": "n8n-nodes-base.stripeTrigger",
      "typeVersion": 1,
      "position": [250, 520],
      "credentials": {
        "stripeApi": { "id": "CONFIGURE_ME", "name": "Stripe" }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normalize enrollment data from different sources\nconst input = $input.first().json;\nlet enrollmentData = {};\n\n// Check if coming from Stripe\nif (input.object === 'checkout.session') {\n  const metadata = input.metadata || {};\n  enrollmentData = {\n    lead_id: metadata.lead_id || '',\n    name: input.customer_details?.name || metadata.name || '',\n    email: input.customer_details?.email || metadata.email || '',\n    phone: metadata.phone || '',\n    amount_paid: (input.amount_total || 0) / 100,\n    currency: input.currency?.toUpperCase() || 'EUR',\n    payment_method: 'stripe',\n    payment_id: input.payment_intent || input.id,\n    payment_status: 'paid',\n    course_date: metadata.course_date || '',\n    course_type: metadata.course_type || 'weekend'\n  };\n} else {\n  // Manual enrollment\n  enrollmentData = {\n    lead_id: input.lead_id || '',\n    name: input.name || '',\n    email: input.email || '',\n    phone: input.phone || '',\n    amount_paid: input.amount || 0,\n    currency: input.currency || 'EUR',\n    payment_method: input.payment_method || 'manual',\n    payment_id: input.payment_id || '',\n    payment_status: input.payment_status || 'pending',\n    course_date: input.course_date || '',\n    course_type: input.course_type || 'weekend'\n  };\n}\n\nenrollmentData.enrollment_id = 'ENR-' + new Date().toISOString().slice(0,10).replace(/-/g,'') + '-' + Math.random().toString(36).substring(2,7).toUpperCase();\nenrollmentData.enrolled_at = new Date().toISOString();\nenrollmentData.status = 'active';\nenrollmentData.certificate_sent = false;\nenrollmentData.documents_sent = false;\n\nreturn [{ json: enrollmentData }];"
      },
      "id": "code-normalize-enrollment",
      "name": "Normalize Enrollment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 400]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "1Nx6rUl00Jg7MGJ8xQeyNL7FldZMNVH-VT8a2psFAxJs" },
